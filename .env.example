# Для реального LLM-режима запустите сервер с этими переменными.
OPENGAME_SECRET=replace-with-random-secret-at-least-32-characters
OPENGAME_SECURE_COOKIE=0
OPENGAME_PUBLIC_URL=https://opengames.duckdns.org
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=no-replay-opengames@internet.ru
SMTP_PASSWORD=
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_API_KEY_BACKUP=sk-or-v1-your-backup-key
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
