{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenGames Connect",
  "version": "0.1.7",
  "identifier": "org.opengames.connect",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "OpenGames Connect", "width": 560, "height": 680, "minWidth": 470, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": { "active": true, "targets": ["dmg"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "externalBin": ["binaries/llama-server"], "resources": ["binaries/LLAMA_LICENSE", "binaries/QWEN_LICENSE"], "macOS": { "signingIdentity": "-" } }
}
